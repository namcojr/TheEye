<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:options="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
    <FontFamily x:Key="AppFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas</FontFamily>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource WindowBackgroundColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="PanelAltBackgroundBrush" Color="{DynamicResource PanelAltBackgroundColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackgroundColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{DynamicResource SelectionColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{DynamicResource HoverBackgroundColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="GridLineBrush" Color="{DynamicResource GridLineColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource ErrorColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="SupervisorBrush" Color="{DynamicResource SupervisorColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="MapWaterBrush" Color="{DynamicResource MapWaterColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="MapLandBrush" Color="{DynamicResource MapLandColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="MapBorderBrush" Color="{DynamicResource MapBorderColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="MapLabelBrush" Color="{DynamicResource MapLabelColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="ShadowBrush" Color="{DynamicResource ShadowColor}"
                     options:Freeze="False" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" options:Freeze="False" />
</ResourceDictionary>
