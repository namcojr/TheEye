<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TheEye.Windows</RootNamespace>
    <AssemblyName>TheEye</AssemblyName>
    <ApplicationIcon>..\..\TheEye.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheEye.Core\TheEye.Core.csproj" />
    <ProjectReference Include="..\TheEye.Presentation\TheEye.Presentation.csproj" />
    <Compile Include="..\Shared\AtcGlyphRenderer.cs" Link="Rendering\AtcGlyphRenderer.cs" />
    <PackageReference Include="Mapsui.Wpf" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The artwork lives in the repository root so the executable and the window
         wear the same icon; linking it keeps that single source of truth. -->
    <Resource Include="..\..\TheEye.ico" Link="Assets\TheEye.ico" />
  </ItemGroup>

</Project>
