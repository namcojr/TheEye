<Window x:Class="TheEye.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TheEye.Windows.Controls"
        xmlns:helpers="clr-namespace:TheEye.Windows.Helpers"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="The Eye of IVAO"
        Icon="pack://application:,,,/Assets/TheEye.ico"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="680"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        helpers:FontScaleBehavior.Scale="{Binding FontScale}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MetricTile" TargetType="{x:Type Border}" BasedOn="{StaticResource FlatCard}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="MapOverlay" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <DataTemplate x:Key="PilotDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource AccentPill}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" FontSize="22" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Aircraft}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="6,0" />
                            <TextBlock Text="VID" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PilotId}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is behind the callsign, once IVAO described the session -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="7,0,0,0"
                                        Padding="6,1">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding ProfileNotice, Converter={StaticResource EmptyStringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="FROM" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Departure}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="16,12,16,0" />
                    <StackPanel>
                        <TextBlock Text="TO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Arrival}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DepartureName}" Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ArrivalName}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" />

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="ALTITUDE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Altitude}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="GROUND SPEED" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Speed}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="HEADING" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="TRANSPONDER" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Transponder}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="TIME ONLINE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding OnlineText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="EST. ARRIVAL" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FLIGHT RULES" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FlightRules}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="FLIGHT TYPE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FlightType}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CRUISE LEVEL" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CruisingLevel}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="CRUISE SPEED" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CruisingSpeed}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid>

                <!-- Connection: the client, simulator and server the member is on -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" ToolTip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SoftwareText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding SimulatorText}">
                            <TextBlock Text="SIMULATOR" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SimulatorText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" ToolTip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ServerText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ConnectedText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <TextBlock Text="ROUTE" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding RouteText}" Style="{StaticResource DetailValueMono}" Margin="0,3,0,0"
                           TextWrapping="Wrap" />

                <!-- <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="POSITION" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST SEEN" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid> -->

                <!-- Filed plan: the cruise figures, the times and the equipment and
                     surveillance codes the tracker summary leaves out, from the
                     session's own filing -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasFlightPlanDetails, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="EET" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EstimatedEnroute}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="ENDURANCE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Endurance}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="ALTERNATE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Alternate}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                    Visibility="{Binding HasSecondAlternate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="SECOND ALTERNATE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Alternate2}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="FILED OFF-BLOCKS" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding FiledDepartureText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="ACTUAL OFF-BLOCKS" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ActualDepartureText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="PEOPLE ON BOARD" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding PeopleOnBoardText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding EquipmentText}">
                            <TextBlock Text="EQUIPMENT" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EquipmentText}" Style="{StaticResource DetailValueMono}" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" ToolTip="{Binding TransponderTypeText}">
                            <TextBlock Text="TRANSPONDER CAPABILITY" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding TransponderTypeText}" Style="{StaticResource DetailValueMono}" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Why the filed details are missing: the endpoint needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding HasFlightPlanNotice, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding FlightPlanNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding Remarks, Converter={StaticResource EmptyStringToVisibility}}">
                    <TextBlock Text="REMARKS" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Remarks}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AtcDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{Binding AccentSoftColor, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrush}}" BorderThickness="1"
                            CornerRadius="8" Padding="7,3" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Facility}" FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" FontSize="22" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StationName}"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="VID" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ControllerId}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is on the frequency, once IVAO described the session -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="7,0,0,0"
                                        Padding="6,1" ToolTip="{Binding RatingName}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding ProfileNotice, Converter={StaticResource EmptyStringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FREQUENCY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Frequency}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SCOPE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Scope}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="AIRPORT" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding AirportIcao}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SECTOR POINTS" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SectorPoints}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"
                                Visibility="{Binding HasAirport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CITY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding City}" Style="{StaticResource DetailValue}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Visibility="{Binding HasAirport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="COUNTRY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CountryName}" Style="{StaticResource DetailValue}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Connection: the client and server the controller is on -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" ToolTip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SoftwareText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ServerText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TIME ONLINE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding OnlineText}" Style="{StaticResource DetailValue}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ConnectedText}" Style="{StaticResource DetailValue}" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AirportDetailTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Icao}" Style="{StaticResource DetailValueMono}"
                           FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource MutedText}"
                           Margin="0,2,0,0" TextWrapping="Wrap" />
                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
                <TextBlock Text="METAR" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding DataContext.AirportMetarStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource MutedText}" FontSize="9" Margin="0,2,0,0" />
                <TextBlock Text="{Binding DataContext.AirportMetarText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource DetailValueMono}" Margin="0,5,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataContext.AirportLocationText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"
                           Visibility="{Binding DataContext.HasAirportLocation, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="POSITION" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Position.Latitude, StringFormat={}{0:0.0000}}"
                                   Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LONGITUDE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Position.Longitude, StringFormat={}{0:0.0000}}"
                                   Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"
                        Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}" />
                <Grid Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RUNWAYS" Style="{StaticResource DetailLabel}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Style="{StaticResource RunwaySelector}" Width="142" Height="20"
                              ItemsSource="{Binding DataContext.SelectedAirportRunwayEnds, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedRunwayEnd, RelativeSource={RelativeSource AncestorType=Window}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Style="{StaticResource DetailValueMono}"
                                           Margin="0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Border Style="{StaticResource FlatCard}" Height="230" Padding="0" Margin="0,7,0,0" ClipToBounds="True"
                        Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}">
                    <controls:RunwayDiagram State="{Binding DataContext.RunwayDiagram, RelativeSource={RelativeSource AncestorType=Window}}"
                                            TextBrush="{DynamicResource TextBrush}"
                                            MutedTextBrush="{DynamicResource MutedTextBrush}"
                                            AccentBrush="{DynamicResource AccentBrush}"
                                            HeadwindBrush="{DynamicResource SuccessBrush}"
                                            TailwindBrush="{DynamicResource ErrorBrush}"
                                            HaloBrush="{DynamicResource PanelAltBackgroundBrush}" />
                </Border>
                <Grid Margin="0,8,0,0" Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TRUE HEADING" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DataContext.SelectedRunwayEnd.HeadingText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LENGTH" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DataContext.SelectedRunwayEnd.LengthText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WIDTH" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DataContext.SelectedRunwayEnd.WidthText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding DataContext.RunwayWindDirectionText, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource MutedText}" Margin="0,10,0,0"
                           Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}" />
                <Grid Margin="0,5,0,0" Visibility="{Binding HasRunways, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CROSSWIND" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding DataContext.RunwayCrosswindText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource DetailValueMono}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding DataContext.RunwayCrosswindSideText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DataContext.RunwayAlongWindLabel, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DetailLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsRunwayTailwind, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding DataContext.RunwayAlongWindText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="16" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource DetailValueMono}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.IsRunwayTailwind, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock Text="No runway data available" Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" Visibility="{Binding HasRunways, Converter={StaticResource InverseBoolToVisibility}}" />
                <Border Style="{StaticResource Divider}" Margin="0,12,0,12"
                        Visibility="{Binding DataContext.HasSelectedAirportAtc, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="ACTIVE ATC" Style="{StaticResource DetailLabel}"
                           Visibility="{Binding DataContext.HasSelectedAirportAtc, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding DataContext.SelectedAirportAtc, RelativeSource={RelativeSource AncestorType=Window}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Callsign}" Style="{StaticResource DetailValueMono}" />
                                    <TextBlock Text="{Binding FacilityName}" Style="{StaticResource MutedText}"
                                               Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Frequency}"
                                           Style="{StaticResource DetailValueMono}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="7"
                                Background="{DynamicResource SelectionBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}"
                                  Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z M 9,5 A 3,3 0 1 1 9,11 A 3,3 0 1 1 9,5 Z" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="THE EYE OF IVAO" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="LIVE NETWORK OVERVIEW" FontSize="8" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" />
                        <Border Width="1" Height="12" Margin="12,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnSettingsClick">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Minimize"
                                AutomationProperties.Name="Minimize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMinimizeClick">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" ToolTip="Maximize"
                                AutomationProperties.Name="Maximize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMaximizeClick">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" ToolTip="Close"
                                AutomationProperties.Name="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnCloseClick">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <!-- Network dashboard, map and selection pane. The dashboard is
                     resizable: the splitter records its width in the settings, so
                     the column comes back at the width the user left it. The
                     selection pane floats over the right edge of the map instead
                     of taking a column of its own, so the map keeps its width and
                     its position when a selection appears or is cleared. The
                     column limits mirror TheEyeSettings.Min/MaxTrafficColumnWidth. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TrafficColumn" Width="322"
                                      MinWidth="248" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Network dashboard -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="14,14,14,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" ToolTip="Pilot table; click again for map"
                                            AutomationProperties.Name="Pilot table" Command="{Binding PilotTableCommand}">
                                        <TextBlock Text="✈" FontSize="13" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="ATC table; click again for map"
                                            AutomationProperties.Name="ATC table" Command="{Binding AtcTableCommand}">
                                        <Grid Width="18" Height="18">
                                            <Ellipse Width="16" Height="16" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.4" />
                                            <Path Data="M 9,9 L 15,3" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.4" />
                                            <Ellipse Width="4" Height="4" Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Supervisor table"
                                            AutomationProperties.Name="Supervisor table" Command="{Binding SupervisorTableCommand}">
                                        <Path Data="M 8,0 C 8.75,4.5 11.5,7.25 16,8 C 11.5,8.75 8.75,11.5 8,16 C 7.25,11.5 4.5,8.75 0,8 C 4.5,7.25 7.25,4.5 8,0 Z"
                                              Width="16" Height="16" Fill="{DynamicResource SupervisorBrush}" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Friends table"
                                            AutomationProperties.Name="Friends table" Command="{Binding FriendTableCommand}">
                                        <Grid Width="18" Height="18">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Top"
                                                     Margin="0,1,0,0"
                                                     Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            <Path Data="M 2,17 C 2,12.5 4.5,10 9,10 C 13.5,10 16,12.5 16,17"
                                                  Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Refresh now"
                                            AutomationProperties.Name="Refresh now" Command="{Binding RefreshCommand}">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="NETWORK OVERVIEW" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,11,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PilotCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="PILOTS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AtcCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="CONTROLLERS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MetricTile}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="CONNECTIONS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,7,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ObserverCount}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" obs" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SupervisorCount}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" sup" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding UniqueUsers24h}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" /24h" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0" ToolTip="Filter by callsign, route, airport, facility or country"
                                     AutomationProperties.Name="Filter traffic" Visibility="Collapsed" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,0,14,14">
                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="ONLINE" Style="{StaticResource MetricLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding PilotCount}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="PILOTS" Style="{StaticResource MetricLabel}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding AtcCount}" Style="{StaticResource MetricValue}" />
                                            <TextBlock Text="CONTROLLERS" Style="{StaticResource MetricLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="unique users / 24h"
                                                       Style="{StaticResource MutedText}" />
                                            <TextBlock Text="ACTIVITY" Style="{StaticResource DetailLabel}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding UniqueUsers24h}" Style="{StaticResource MetricValue}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="LAST 24 POLLS" Style="{StaticResource DetailLabel}"
                                                   Margin="0,0,0,3" />
                                        <ItemsControl ItemsSource="{Binding ActivitySamples}" Height="38" Margin="0,0,0,8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="6" Height="{Binding BarHeight}" Margin="1,0"
                                                            VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                                            CornerRadius="2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="{Binding WorldTourCount}" Style="{StaticResource MonoText}" />
                                                <TextBlock Text=" WT" Style="{StaticResource MutedText}" Margin="3,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding ObserverCount}" Style="{StaticResource MonoText}" />
                                                <TextBlock Text=" OBS" Style="{StaticResource MutedText}" Margin="3,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="{Binding SupervisorCount}" Style="{StaticResource MonoText}" />
                                                <TextBlock Text=" SUP" Style="{StaticResource MutedText}" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="IN / OUT"
                                                       Style="{StaticResource MutedText}" FontSize="9" />
                                            <TextBlock Text="POPULAR AIRPORTS" Style="{StaticResource DetailLabel}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding PopularAirportStats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="42" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Icao}" Style="{StaticResource MonoText}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <ProgressBar Height="4" Maximum="100"
                                                                         Value="{Binding InboundPercent}"
                                                                         Foreground="{DynamicResource AccentBrush}"
                                                                         Background="{DynamicResource BorderBrush}" />
                                                            <ProgressBar Height="4" Margin="0,2,0,0" Maximum="100"
                                                                         Value="{Binding OutboundPercent}"
                                                                         Foreground="{DynamicResource MutedTextBrush}"
                                                                         Background="{DynamicResource BorderBrush}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding TrafficText}"
                                                                   Style="{StaticResource MutedText}" FontSize="9"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No filed airport data in the live feed"
                                                   Style="{StaticResource MutedText}"
                                                   Visibility="{Binding HasNoPopularAirportStats, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource FlatCard}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OnlineFriendCount}"
                                                       Style="{StaticResource MonoText}" />
                                            <TextBlock Text="FRIENDS ONLINE" Style="{StaticResource DetailLabel}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding OnlineFriends}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Style="{StaticResource MutedText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No friends online" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding HasNoOnlineFriends, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <TabControl Grid.Row="1" SelectedIndex="0" Visibility="Collapsed">
                            <TabItem AutomationProperties.Name="Pilots">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PILOTS" />
                                        <TextBlock Text="{Binding PilotCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding PilotsView}"
                                          SelectedItem="{Binding SelectedPilot, Mode=TwoWay}"
                                          AutomationProperties.Name="Pilot list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <!-- A member IVAO lists with supervisor rights is
                                         painted behind the whole row, not marked with a
                                         glyph beside the callsign. -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ROUTE" Width="*">
                                            <DataGridTextColumn.Binding>
                                                <MultiBinding StringFormat="{}{0} → {1}">
                                                    <Binding Path="Departure" />
                                                    <Binding Path="Arrival" />
                                                </MultiBinding>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ALT" Width="76"
                                                            Binding="{Binding Altitude}" />
                                        <DataGridTemplateColumn Width="34" CanUserSort="False"
                                                                CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★"
                                                               Foreground="{DynamicResource SupervisorBrush}"
                                                               Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               ToolTip="This member holds supervisor rights" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="ATC">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ATC" />
                                        <TextBlock Text="{Binding AtcCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding AtcView}"
                                          SelectedItem="{Binding SelectedAtc, Mode=TwoWay}"
                                          AutomationProperties.Name="ATC list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="FACILITY" Width="*"
                                                            Binding="{Binding FacilityName}" />
                                        <DataGridTextColumn Header="FREQ" Width="76"
                                                            Binding="{Binding Frequency}" />
                                        <DataGridTemplateColumn Width="34" CanUserSort="False"
                                                                CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★"
                                                               Foreground="{DynamicResource SupervisorBrush}"
                                                               Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               ToolTip="This member holds supervisor rights" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="Supervisors">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SUP" />
                                        <TextBlock Text="{Binding SupervisorListCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource SupervisorBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding SupervisorsView}"
                                          SelectedItem="{Binding SelectedSupervisor, Mode=TwoWay}"
                                          AutomationProperties.Name="Supervisor list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="MEMBER" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TooltipText}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="Friends">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="FRIENDS" />
                                        <TextBlock Text="{Binding FriendCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding FriendsView}"
                                          SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                                          AutomationProperties.Name="Friend list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CALLSIGN" Width="96"
                                                            Binding="{Binding Callsign}" />
                                        <DataGridTemplateColumn Header="MEMBER" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding TooltipText}">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                Width="20" Height="20" Padding="0"
                                                                ToolTip="Remove this friend"
                                                                AutomationProperties.Name="Remove friend"
                                                                Command="{Binding DataContext.ToggleFriendCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}">
                                                            <!-- Drawn instead of typed: the icon-font glyph of the
                                                                 first draft landed as an empty box on some machines. -->
                                                            <Path Data="M 0.6,2.6 H 9.4 M 3.4,2.6 V 1.1 H 6.6 V 2.6 M 1.5,2.6 L 2.1,9.4 H 7.9 L 8.5,2.6"
                                                                  Stroke="{DynamicResource MutedTextBrush}"
                                                                  StrokeThickness="1.1"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Width="10" Height="10" Stretch="None" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="STATE" Width="76"
                                                            Binding="{Binding ActivityText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- The grab handle of the network dashboard. A transparent four
                     pixel strip keeps the panel borders as the only visible
                     separator. -->
                <GridSplitter x:Name="TrafficSplitter" Grid.Column="1" Width="4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Resize dashboard"
                              ToolTip="Drag to resize the dashboard"
                              DragCompleted="OnTrafficSplitterDragCompleted" />

                <!-- Offline world map with the WPF pilot marker overlay -->
                    <Grid Grid.Column="2" Background="{DynamicResource MapWaterBrush}" ClipToBounds="True"
                        Visibility="{Binding IsMapView, Converter={StaticResource BoolToVisibility}}"
                      PreviewMouseWheel="OnMapWheel">
                    <mapsui:MapControl x:Name="MapControl" Map="{Binding Map.Map}" MapTapped="OnMapTapped"
                                       MouseMove="OnMapMouseMove" MouseLeave="OnMapMouseLeave" />

                    <ItemsControl ItemsSource="{Binding Map.Pilots}"
                                  Visibility="{Binding Map.ShowPilots, Converter={StaticResource BoolToVisibility}}"
                                  Panel.ZIndex="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Visibility"
                                        Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding MarkerSize}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Button Style="{StaticResource PilotMarkerButton}"
                                            MouseEnter="OnPilotMarkerEnter"
                                            MouseLeave="OnPilotMarkerLeave"
                                            Click="OnPilotMarkerClick" />
                                    <TextBlock Grid.Row="1" Text="{Binding Callsign}" Margin="-100,0,-100,0"
                                               TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="None"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Canvas IsHitTestVisible="False" Panel.ZIndex="3">
                        <Border Canvas.Left="{Binding Map.MapTooltipX}" Canvas.Top="{Binding Map.MapTooltipY}"
                                Visibility="{Binding Map.HasMapTooltip, Converter={StaticResource BoolToVisibility}}"
                                Width="190" Padding="10,6" CornerRadius="4"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding Map.MapTooltipText}" FontSize="12"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextBrush}" />
                        </Border>
                    </Canvas>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="14">
                        <ToggleButton Content="PILOTS" IsChecked="{Binding ShowPilots}"
                                      Margin="0,0,6,0" ToolTip="Show or hide aircraft" />
                        <ToggleButton Content="ATC" IsChecked="{Binding ShowAtc}"
                                      Margin="0,0,6,0" ToolTip="Show or hide controllers, sectors and stations" />
                        <ToggleButton Content="AIRPORTS" IsChecked="{Binding ShowAirports}"
                                      ToolTip="Show or hide airports with active traffic" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7" Margin="0,0,0,6"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7" Margin="0,6,0,0"
                                Visibility="{Binding HasTrackNotice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TrackNotice}" Foreground="{DynamicResource WarningBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                    </StackPanel>

                    <!-- The selection pane covers the right edge of the map while
                         something is selected, so the zoom controls step left by
                         its width instead of hiding under it. -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14">
                        <Border Width="348"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel>
                            <Button Style="{StaticResource SquareButton}"
                                    ToolTip="Zoom in" AutomationProperties.Name="Zoom in"
                                    Command="{Binding ZoomInCommand}" Margin="0,0,0,5">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource SquareButton}"
                                    ToolTip="Zoom out" AutomationProperties.Name="Zoom out"
                                    Command="{Binding ZoomOutCommand}" Margin="0,0,0,5">
                                <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource SquareButton}"
                                    ToolTip="Reset the world view" AutomationProperties.Name="Reset view"
                                    Command="{Binding HomeCommand}">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource MapOverlay}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="14">
                        <TextBlock Style="{StaticResource MutedText}" FontSize="9.5"
                                   Text="DRAG TO PAN  ·  SCROLL TO ZOOM  ·  CLICK TO SELECT" />
                    </Border>
                </Grid>

                <Border Grid.Column="2" Panel.ZIndex="3"
                        Visibility="{Binding IsPilotTableView, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Right" Width="190"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by callsign, route, airport, facility or country"
                                         AutomationProperties.Name="Search pilots" Margin="12,0,14,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PilotTableSortStatus}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <TextBlock Text="ONLINE PILOTS" Style="{StaticResource SectionTitle}"
                                           Margin="14,12" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="0,0,0,42" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="{DynamicResource HeaderBackgroundBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="0.72*" /><ColumnDefinition Width="0.72*" />
                                        <ColumnDefinition Width="0.78*" /><ColumnDefinition Width="0.78*" />
                                        <ColumnDefinition Width="0.92*" /><ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="CALLSIGN" Command="{Binding SortPilotTableCommand}" CommandParameter="Callsign" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="MEMBER" Command="{Binding SortPilotTableCommand}" CommandParameter="Member" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="AIRCRAFT" Command="{Binding SortPilotTableCommand}" CommandParameter="Aircraft" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="FROM" Command="{Binding SortPilotTableCommand}" CommandParameter="Departure" />
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="TO" Command="{Binding SortPilotTableCommand}" CommandParameter="Arrival" />
                                    <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="ALT" Command="{Binding SortPilotTableCommand}" CommandParameter="Altitude" />
                                    <Button Grid.Column="6" Style="{StaticResource GhostButton}" Content="SPEED" Command="{Binding SortPilotTableCommand}" CommandParameter="Speed" />
                                    <Button Grid.Column="7" Style="{StaticResource GhostButton}" Content="STATE" Command="{Binding SortPilotTableCommand}" CommandParameter="State" />
                                    <Button Grid.Column="8" Style="{StaticResource GhostButton}" Content="ONLINE" Command="{Binding SortPilotTableCommand}" CommandParameter="Online" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PilotsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectPilotFromTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                        Padding="8,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="1.1*" />
                                                        <ColumnDefinition Width="0.72*" /><ColumnDefinition Width="0.72*" />
                                                        <ColumnDefinition Width="0.78*" /><ColumnDefinition Width="0.78*" />
                                                        <ColumnDefinition Width="0.92*" /><ColumnDefinition Width="0.9*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CallsignLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MemberText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MemberText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Aircraft}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Aircraft}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Departure}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding Arrival}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding Altitude}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Speed}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="8" Text="{Binding OnlineText}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14,0,0,10" Padding="8,5"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FRIENDS" FontSize="9" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" Margin="5,0,10,0"
                                        Background="#FF38BDF8" />
                                <TextBlock Text="SUPERVISORS" FontSize="9" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" Margin="5,0,0,0"
                                        Background="#FFE84393" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Panel.ZIndex="3"
                        Visibility="{Binding IsAtcTableView, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True">
                                <TextBox DockPanel.Dock="Right" Width="190"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by callsign, route, airport, facility or country"
                                         AutomationProperties.Name="Search controllers" Margin="12,0,14,0" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding AtcTableSortStatus}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <TextBlock Text="ONLINE ATC" Style="{StaticResource SectionTitle}"
                                           Margin="14,12" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" Margin="0,0,0,42" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="{DynamicResource HeaderBackgroundBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.9*" />
                                        <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.45*" />
                                        <ColumnDefinition Width="2.5*" /><ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource GhostButton}" Content="CALLSIGN" Command="{Binding SortAtcTableCommand}" CommandParameter="Callsign" />
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="MEMBER" Command="{Binding SortAtcTableCommand}" CommandParameter="Member" />
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="FACILITY" Command="{Binding SortAtcTableCommand}" CommandParameter="Facility" />
                                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="FREQ" Command="{Binding SortAtcTableCommand}" CommandParameter="Frequency" />
                                    <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="AIRPORT" Command="{Binding SortAtcTableCommand}" CommandParameter="Airport" />
                                    <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="COUNTRY" Command="{Binding SortAtcTableCommand}" CommandParameter="Country" />
                                    <Button Grid.Column="6" Style="{StaticResource GhostButton}" Content="SCOPE" Command="{Binding SortAtcTableCommand}" CommandParameter="Scope" />
                                    <Button Grid.Column="7" Style="{StaticResource GhostButton}" Content="ONLINE" Command="{Binding SortAtcTableCommand}" CommandParameter="Online" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AtcView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectAtcFromTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="8,7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                                        <ColumnDefinition Width="0.9*" /><ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.45*" />
                                                        <ColumnDefinition Width="2.5*" /><ColumnDefinition Width="0.9*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding CallsignLabel}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MemberText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MemberText}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding FacilityName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FacilityName}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Frequency}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding AirportIcao}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    <TextBlock Grid.Column="5" Text="{Binding CountryName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CountryName}" />
                                                    <TextBlock Grid.Column="6" Text="{Binding Scope}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Scope}" />
                                                    <TextBlock Grid.Column="7" Text="{Binding OnlineText}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                </Grid>
                                            </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14,0,0,10" Padding="8,5"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FRIENDS" FontSize="9" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" Margin="5,0,10,0"
                                        Background="#FF38BDF8" />
                                <TextBlock Text="SUPERVISORS" FontSize="9" VerticalAlignment="Center" />
                                <Border Width="8" Height="8" Margin="5,0,0,0"
                                        Background="#FFE84393" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Panel.ZIndex="3"
                        Visibility="{Binding IsSupervisorTableView, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="190"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search supervisors" Margin="12,0,14,0" />
                                <TextBlock Text="SUPERVISORS" Style="{StaticResource SectionTitle}" Margin="14,12" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="{DynamicResource HeaderBackgroundBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" />
                                        <ColumnDefinition Width="2*" /><ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CALLSIGN" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="1" Text="MEMBER" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="2" Text="CONNECTED AS" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="3" Text="DIVISION" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="4" Text="STAFF POSITIONS" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="5" Text="ONLINE" Style="{StaticResource DetailLabel}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SupervisorsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectSupervisorFromTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.2*" />
                                                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DivisionText}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding StaffText}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="5" Text="{Binding OnlineText}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Panel.ZIndex="3"
                        Visibility="{Binding IsFriendTableView, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource PanelBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel>
                                <TextBox DockPanel.Dock="Right" Width="190"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search friends" Margin="12,0,14,0" />
                                <TextBlock Text="FRIENDS" Style="{StaticResource SectionTitle}" Margin="14,12" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Background="{DynamicResource HeaderBackgroundBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="0.9*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CALLSIGN" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="1" Text="MEMBER" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="2" Text="ACTIVITY" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="3" Text="DETAILS" Style="{StaticResource DetailLabel}" />
                                    <TextBlock Grid.Column="4" Text="ONLINE" Style="{StaticResource DetailLabel}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FriendsView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectFriendFromTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.5*" />
                                                            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ActivityText}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="4" Text="{Binding OnlineText}" FontFamily="{DynamicResource MonoFontFamily}" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Selection detail pane. It floats over the right edge of the map
                     while something is selected, so opening and closing it never
                     resizes or moves the map underneath; with nothing picked there
                     is nothing to inspect and it is hidden. -->
                <Border Grid.Column="2" Width="348" Panel.ZIndex="4"
                        HorizontalAlignment="Right"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="14,11">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        ToolTip="Clear selection" AutomationProperties.Name="Clear selection"
                                        Command="{Binding ClearSelectionCommand}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                        Height="20" Padding="8,0" FontSize="9" Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding FriendActionText}"
                                        Command="{Binding ToggleFriendCommand}"
                                        Visibility="{Binding HasMemberSelection, Converter={StaticResource BoolToVisibility}}"
                                        AutomationProperties.Name="Toggle friend"
                                        ToolTip="Follow this member: their callsign carries a star in the lists and they are collected on the FRIENDS tab" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SELECTION" Style="{StaticResource SectionTitle}" />
                                        <Border Style="{StaticResource AccentPill}"
                                                Background="{DynamicResource SupervisorBrush}"
                                                Visibility="{Binding IsSelectionSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="SUPERVISOR" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Click a marker, sector or list row" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="16,14,16,18">
                            <Grid>
                                <ContentControl Content="{Binding SelectedPilot}"
                                                ContentTemplate="{StaticResource PilotDetailTemplate}"
                                                Visibility="{Binding SelectedPilot, Converter={StaticResource NullToVisibility}}" />
                                <ContentControl Content="{Binding SelectedAtc}"
                                                ContentTemplate="{StaticResource AtcDetailTemplate}"
                                                Visibility="{Binding SelectedAtc, Converter={StaticResource NullToVisibility}}" />
                                <ContentControl Content="{Binding SelectedAirport}"
                                                ContentTemplate="{StaticResource AirportDetailTemplate}"
                                                Visibility="{Binding SelectedAirport, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RefreshDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding ThemeDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="SETTINGS" Height="20"
                                Padding="8,0" FontSize="9" Click="OnSettingsClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MonoText}"
                                   FontSize="10" VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding ConnectionDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding Map.Pilots.Count, StringFormat={}{0} aircraft tracked}"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
