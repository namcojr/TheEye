<Window x:Class="TheEye.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="The Eye of IVAO"
        Icon="pack://application:,,,/Assets/TheEye.ico"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="680"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MetricTile" TargetType="{x:Type Border}" BasedOn="{StaticResource FlatCard}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="MapOverlay" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,6" />
        </Style>
        <DataTemplate x:Key="PilotDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource AccentPill}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" FontSize="22" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Aircraft}" Style="{StaticResource MutedText}" />
                            <TextBlock Text="·" Style="{StaticResource MutedText}" Margin="6,0" />
                            <TextBlock Text="VID" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PilotId}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is behind the callsign, once IVAO described the session -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="7,0,0,0"
                                        Padding="6,1">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding ProfileNotice, Converter={StaticResource EmptyStringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="FROM" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Departure}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="16,12,16,0" />
                    <StackPanel>
                        <TextBlock Text="TO" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Arrival}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DepartureName}" Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ArrivalName}" Style="{StaticResource MutedText}"
                           TextTrimming="CharacterEllipsis" />

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="ALTITUDE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Altitude}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="GROUND SPEED" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Speed}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="HEADING" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Heading}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="TRANSPONDER" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Transponder}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="TIME ONLINE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding OnlineText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="EST. ARRIVAL" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FLIGHT RULES" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FlightRules}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="FLIGHT TYPE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding FlightType}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CRUISE LEVEL" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CruisingLevel}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="CRUISE SPEED" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CruisingSpeed}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid>

                <!-- Connection: the client, simulator and server the member is on -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" ToolTip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SoftwareText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding SimulatorText}">
                            <TextBlock Text="SIMULATOR" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SimulatorText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" ToolTip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ServerText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ConnectedText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <TextBlock Text="ROUTE" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding RouteText}" Style="{StaticResource DetailValueMono}" Margin="0,3,0,0"
                           TextWrapping="Wrap" MaxHeight="128" />

                <!-- <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="POSITION" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST SEEN" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding LastSeenText}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                </Grid> -->

                <!-- Filed plan: the cruise figures, the times and the equipment and
                     surveillance codes the tracker summary leaves out, from the
                     session's own filing -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasFlightPlanDetails, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="EET" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EstimatedEnroute}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="ENDURANCE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Endurance}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="ALTERNATE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Alternate}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                    Visibility="{Binding HasSecondAlternate, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="SECOND ALTERNATE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding Alternate2}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="FILED OFF-BLOCKS" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding FiledDepartureText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                            <TextBlock Text="ACTUAL OFF-BLOCKS" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ActualDepartureText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="PEOPLE ON BOARD" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding PeopleOnBoardText}" Style="{StaticResource DetailValueMono}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding EquipmentText}">
                            <TextBlock Text="EQUIPMENT" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding EquipmentText}" Style="{StaticResource DetailValueMono}" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" ToolTip="{Binding TransponderTypeText}">
                            <TextBlock Text="TRANSPONDER CAPABILITY" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding TransponderTypeText}" Style="{StaticResource DetailValueMono}" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Why the filed details are missing: the endpoint needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding HasFlightPlanNotice, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding FlightPlanNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,12,0,0"
                            Visibility="{Binding Remarks, Converter={StaticResource EmptyStringToVisibility}}">
                    <TextBlock Text="REMARKS" Style="{StaticResource DetailLabel}" />
                    <TextBlock Text="{Binding Remarks}" Style="{StaticResource MutedText}" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AtcDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{Binding AccentSoftColor, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrush}}" BorderThickness="1"
                            CornerRadius="8" Padding="7,3" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Facility}" FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" FontSize="22" FontWeight="Bold"
                                   FontFamily="{DynamicResource MonoFontFamily}" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StationName}"
                                       Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="VID" Style="{StaticResource MutedText}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ControllerId}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is on the frequency, once IVAO described the session -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Style="{StaticResource Pill}" Margin="7,0,0,0"
                                        Padding="6,1" ToolTip="{Binding RatingName}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,8"
                        Visibility="{Binding ProfileNotice, Converter={StaticResource EmptyStringToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FREQUENCY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Frequency}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SCOPE" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding Scope}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="AIRPORT" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding AirportIcao}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SECTOR POINTS" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding SectorPoints}" Style="{StaticResource DetailValueMono}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"
                                Visibility="{Binding HasAirport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CITY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding City}" Style="{StaticResource DetailValue}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Visibility="{Binding HasAirport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="COUNTRY" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding CountryName}" Style="{StaticResource DetailValue}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />

                <TextBlock Text="STATION POSITION" Style="{StaticResource DetailLabel}" />
                <TextBlock Text="{Binding PositionText}" Style="{StaticResource DetailValueMono}" Margin="0,3,0,0" />
                <TextBlock Text="{Binding AirportName}" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasAirport, Converter={StaticResource BoolToVisibility}}" />

                <!-- Connection: the client and server the controller is on -->
                <Border Style="{StaticResource FlatCard}" Margin="0,12,0,0" Padding="11,9"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" ToolTip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding SoftwareText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" ToolTip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ServerText}" Style="{StaticResource DetailValue}"
                                       Margin="0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TIME ONLINE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding OnlineText}" Style="{StaticResource DetailValue}" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ConnectedText}" Style="{StaticResource DetailValue}" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="28" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="27" Height="27" CornerRadius="7"
                                Background="{DynamicResource SelectionBrush}"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentBrush}"
                                  Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z M 9,5 A 3,3 0 1 1 9,11 A 3,3 0 1 1 9,5 Z" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="THE EYE OF IVAO" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="LIVE NETWORK OVERVIEW" FontSize="8" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="{x:Type Ellipse}">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold" />
                        <Border Width="1" Height="12" Margin="12,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource MutedText}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource WindowButton}" ToolTip="Settings"
                                AutomationProperties.Name="Settings"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnSettingsClick">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource WindowButton}" ToolTip="Minimize"
                                AutomationProperties.Name="Minimize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMinimizeClick">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" ToolTip="Maximize"
                                AutomationProperties.Name="Maximize"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnMaximizeClick">
                            <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource CloseWindowButton}" ToolTip="Close"
                                AutomationProperties.Name="Close"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnCloseClick">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="322" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="348" />
                </Grid.ColumnDefinitions>

                <!-- Traffic browser -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="14,14,14,10">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        ToolTip="Refresh now" AutomationProperties.Name="Refresh now"
                                        Command="{Binding RefreshCommand}">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LIVE TRAFFIC" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,11,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MetricTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PilotCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="PILOTS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource MetricTile}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AtcCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="CONTROLLERS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource MetricTile}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricValue}" />
                                        <TextBlock Text="CONNECTIONS" Style="{StaticResource MetricLabel}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding ObserverCount}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" obs" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding SupervisorCount}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" sup" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <TextBlock Text="{Binding UniqueUsers24h}" Style="{StaticResource MonoText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text=" /24h" Style="{StaticResource MutedText}" Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,12,0,0" ToolTip="Filter by callsign, route, airport, facility or country"
                                     AutomationProperties.Name="Filter traffic" />
                        </StackPanel>

                        <TabControl Grid.Row="1" SelectedIndex="0">
                            <TabItem AutomationProperties.Name="Pilots">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PILOTS" />
                                        <TextBlock Text="{Binding PilotCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding PilotsView}"
                                          SelectedItem="{Binding SelectedPilot, Mode=TwoWay}"
                                          AutomationProperties.Name="Pilot list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <!-- A member IVAO lists with supervisor rights is
                                         painted behind the whole row, not marked with a
                                         glyph beside the callsign. -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="ROUTE" Width="*">
                                            <DataGridTextColumn.Binding>
                                                <MultiBinding StringFormat="{}{0} → {1}">
                                                    <Binding Path="Departure" />
                                                    <Binding Path="Arrival" />
                                                </MultiBinding>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="ALT" Width="76"
                                                            Binding="{Binding Altitude}" />
                                        <DataGridTemplateColumn Width="34" CanUserSort="False"
                                                                CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★"
                                                               Foreground="{DynamicResource SupervisorBrush}"
                                                               Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               ToolTip="This member holds supervisor rights" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="ATC">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ATC" />
                                        <TextBlock Text="{Binding AtcCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding AtcView}"
                                          SelectedItem="{Binding SelectedAtc, Mode=TwoWay}"
                                          AutomationProperties.Name="ATC list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="{x:Type DataGridRow}"
                                               BasedOn="{StaticResource {x:Type DataGridRow}}">
                                            <Setter Property="Background"
                                                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="FACILITY" Width="*"
                                                            Binding="{Binding FacilityName}" />
                                        <DataGridTextColumn Header="FREQ" Width="76"
                                                            Binding="{Binding Frequency}" />
                                        <DataGridTemplateColumn Width="34" CanUserSort="False"
                                                                CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="★"
                                                               Foreground="{DynamicResource SupervisorBrush}"
                                                               Visibility="{Binding IsSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               ToolTip="This member holds supervisor rights" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="Supervisors">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SUP" />
                                        <TextBlock Text="{Binding SupervisorListCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource SupervisorBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding SupervisorsView}"
                                          SelectedItem="{Binding SelectedSupervisor, Mode=TwoWay}"
                                          AutomationProperties.Name="Supervisor list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="CALLSIGN" Width="96">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CallsignLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="MEMBER" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding TooltipText}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem AutomationProperties.Name="Friends">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="FRIENDS" />
                                        <TextBlock Text="{Binding FriendCount, StringFormat='  {0}'}"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DataGrid ItemsSource="{Binding FriendsView}"
                                          SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                                          AutomationProperties.Name="Friend list"
                                          MouseDoubleClick="OnTrafficDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="CALLSIGN" Width="96"
                                                            Binding="{Binding Callsign}" />
                                        <DataGridTemplateColumn Header="MEMBER" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <DockPanel ToolTip="{Binding TooltipText}">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                                Width="20" Height="20" Padding="0"
                                                                ToolTip="Remove this friend"
                                                                AutomationProperties.Name="Remove friend"
                                                                Command="{Binding DataContext.ToggleFriendCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                CommandParameter="{Binding}">
                                                            <!-- Drawn instead of typed: the icon-font glyph of the
                                                                 first draft landed as an empty box on some machines. -->
                                                            <Path Data="M 0.6,2.6 H 9.4 M 3.4,2.6 V 1.1 H 6.6 V 2.6 M 1.5,2.6 L 2.1,9.4 H 7.9 L 8.5,2.6"
                                                                  Stroke="{DynamicResource MutedTextBrush}"
                                                                  StrokeThickness="1.1"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                  StrokeLineJoin="Round"
                                                                  Width="10" Height="10" Stretch="None" />
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="STATE" Width="76"
                                                            Binding="{Binding ActivityText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <!-- Offline world map with the WPF pilot marker overlay -->
                <Grid Grid.Column="1" Background="{DynamicResource MapWaterBrush}" ClipToBounds="True"
                      PreviewMouseWheel="OnMapWheel">
                    <mapsui:MapControl x:Name="MapControl" Map="{Binding Map.Map}" MapTapped="OnMapTapped" />

                    <ItemsControl ItemsSource="{Binding Map.Pilots}"
                                  Visibility="{Binding Map.ShowPilots, Converter={StaticResource BoolToVisibility}}"
                                  Panel.ZIndex="2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="{x:Type ContentPresenter}">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                <Setter Property="Visibility"
                                        Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PilotMarkerButton}"
                                        MouseEnter="OnPilotMarkerEnter"
                                        MouseLeave="OnPilotMarkerLeave"
                                        Click="OnPilotMarkerClick" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="14">
                        <ToggleButton Content="PILOTS" IsChecked="{Binding ShowPilots}"
                                      Margin="0,0,6,0" ToolTip="Show or hide aircraft" />
                        <ToggleButton Content="ATC" IsChecked="{Binding ShowAtc}"
                                      ToolTip="Show or hide controllers, sectors and stations" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14">
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7" Margin="0,0,0,6"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                        <Border Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="12,7" Margin="0,6,0,0"
                                Visibility="{Binding HasTrackNotice, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding TrackNotice}" Foreground="{DynamicResource WarningBrush}"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="520" />
                        </Border>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14">
                        <Button Style="{StaticResource SquareButton}"
                                ToolTip="Zoom in" AutomationProperties.Name="Zoom in"
                                Command="{Binding ZoomInCommand}" Margin="0,0,0,5">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource SquareButton}"
                                ToolTip="Zoom out" AutomationProperties.Name="Zoom out"
                                Command="{Binding ZoomOutCommand}" Margin="0,0,0,5">
                            <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource SquareButton}"
                                ToolTip="Reset the world view" AutomationProperties.Name="Reset view"
                                Command="{Binding HomeCommand}">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        </Button>
                    </StackPanel>

                    <Border Style="{StaticResource MapOverlay}" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="14">
                        <TextBlock Style="{StaticResource MutedText}" FontSize="9.5"
                                   Text="DRAG TO PAN  ·  SCROLL TO ZOOM  ·  CLICK TO SELECT" />
                    </Border>
                </Grid>

                <!-- Selection detail pane -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="14,11">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                        ToolTip="Clear selection" AutomationProperties.Name="Clear selection"
                                        Command="{Binding ClearSelectionCommand}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                                        Height="20" Padding="8,0" FontSize="9" Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Content="{Binding FriendActionText}"
                                        Command="{Binding ToggleFriendCommand}"
                                        AutomationProperties.Name="Toggle friend"
                                        ToolTip="Follow this member: their callsign carries a star in the lists and they are collected on the FRIENDS tab" />
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="SELECTION" Style="{StaticResource SectionTitle}" />
                                        <Border Style="{StaticResource AccentPill}"
                                                Background="{DynamicResource SupervisorBrush}"
                                                Visibility="{Binding IsSelectionSupervisor, Converter={StaticResource BoolToVisibility}}"
                                                Margin="8,0,0,0">
                                            <TextBlock Text="SUPERVISOR" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Click a marker, sector or list row" Style="{StaticResource MutedText}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      Padding="16,14,16,18">
                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="0,60,0,0"
                                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                                    <TextBlock Text="&#xE81E;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="Nothing selected" FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxWidth="230" Margin="0,5,0,0"
                                               Text="Pick an aircraft or controller to inspect the live flight plan, telemetry and radio details." />
                                </StackPanel>

                                <ContentControl Content="{Binding SelectedPilot}"
                                                ContentTemplate="{StaticResource PilotDetailTemplate}"
                                                Visibility="{Binding SelectedPilot, Converter={StaticResource NullToVisibility}}" />
                                <ContentControl Content="{Binding SelectedAtc}"
                                                ContentTemplate="{StaticResource AtcDetailTemplate}"
                                                Visibility="{Binding SelectedAtc, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RefreshDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding ThemeDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="SETTINGS" Height="20"
                                Padding="8,0" FontSize="9" Click="OnSettingsClick" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource MonoText}"
                                   FontSize="10" VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding ConnectionDescription}" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" />
                        <Border Width="1" Height="11" Margin="10,0" Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{Binding Map.Pilots.Count, StringFormat={}{0} aircraft tracked}"
                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
