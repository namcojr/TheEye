<Window x:Class="TheEye.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings — The Eye of IVAO"
        Width="560" Height="780"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="SETTINGS" Margin="9,0,0,0" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Style="{StaticResource CloseWindowButton}" HorizontalAlignment="Right"
                            ToolTip="Close settings" AutomationProperties.Name="Close settings"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Click="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,20,22,10">
                <StackPanel>
                    <TextBlock Text="REFRESH INTERVAL" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,9" TextWrapping="Wrap"
                               Text="How often the tracker polls IVAO. Shorter intervals update faster and use more requests." />
                    <ItemsControl ItemsSource="{Binding IntervalOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="RefreshInterval"
                                             Content="{Binding Label}" Margin="0,0,8,8"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                    <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,9" TextWrapping="Wrap"
                               Text="The shell and the offline map recolor together. The map keeps the same layers and traffic." />
                    <ItemsControl ItemsSource="{Binding ThemeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ChoiceButton}" GroupName="Theme"
                                             Margin="0,0,8,8" AutomationProperties.Name="{Binding Label}"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" CornerRadius="3"
                                                Background="{Binding BackgroundPreview}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Border Width="6" Height="6" CornerRadius="2"
                                                    Background="{Binding AccentPreview}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                    <TextBlock Text="MAP LAYERS" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                    <StackPanel Margin="0,9,0,0">
                        <CheckBox Content="Show pilots" IsChecked="{Binding Draft.ShowPilots}" Margin="0,0,0,9" />
                        <CheckBox Content="Show ATC sectors, labels and stations" IsChecked="{Binding Draft.ShowAtc}" Margin="0,0,0,9" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,10,0,0" />

                    <TextBlock Text="MAP BEHAVIOUR" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                    <StackPanel Margin="0,9,0,0">
                        <CheckBox IsChecked="{Binding Draft.CenterOnMapClick}"
                                  Content="Centre the map when I click an aircraft or station on it"
                                  AutomationProperties.Name="Centre the map on map clicks" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap"
                               Text="Only affects clicks on the map." />

                    <Border Style="{StaticResource Divider}" Margin="0,18,0,18" />

                    <TextBlock Text="CONNECTION" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="IVAO API KEY" Style="{StaticResource DetailLabel}" Margin="0,12,0,5" />
                    <TextBox Text="{Binding Draft.ApiKey, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="IVAO API key"
                             FontFamily="{DynamicResource MonoFontFamily}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="Optional. Without a key the app reads the public tracker summary only. The recorded tracks behind the altitude-coloured trail are an authenticated endpoint: request your own consumer key on api.ivao.aero and paste it here to trace the selected flight or station." />
                    <Border Style="{StaticResource Divider}" Margin="0,18,0,0" />

                    <TextBlock Text="IVAO SIGN-IN" Style="{StaticResource SectionTitle}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,9" TextWrapping="Wrap"
                               Text="Signing in authorises the app as you, which is how the recorded tracks and the per-session details become readable without a consumer key. Create an application on developers.ivao.aero, add the redirect URL below to its allowed URLs, then paste the client id and secret it gives you." />

                    <TextBlock Text="CLIENT ID" Style="{StaticResource DetailLabel}" Margin="0,0,0,5" />
                    <TextBox Text="{Binding Draft.OAuthClientId, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="IVAO application client id"
                             FontFamily="{DynamicResource MonoFontFamily}" />

                    <TextBlock Text="CLIENT SECRET" Style="{StaticResource DetailLabel}" Margin="0,10,0,5" />
                    <PasswordBox x:Name="ClientSecretBox"
                                 AutomationProperties.Name="IVAO application client secret"
                                 PasswordChanged="OnClientSecretChanged" />

                    <TextBlock Text="REDIRECT URL" Style="{StaticResource DetailLabel}" Margin="0,10,0,5" />
                    <TextBox Text="{Binding Draft.OAuthRedirectUri, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="IVAO sign-in redirect URL"
                             LostFocus="OnRedirectUriLostFocus"
                             FontFamily="{DynamicResource MonoFontFamily}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{Binding RedirectUriHint}" />

                    <TextBlock Text="SCOPES" Style="{StaticResource DetailLabel}" Margin="0,10,0,5" />
                    <TextBox Text="{Binding Draft.OAuthScopes, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="IVAO sign-in scopes"
                             FontFamily="{DynamicResource MonoFontFamily}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="IVAO approves scopes per application. The tracker scope covers recorded sessions; an application approved without it still reads the public traffic." />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="SignInButton" Style="{StaticResource PrimaryButton}" MinWidth="136"
                                Content="Sign in with IVAO" AutomationProperties.Name="Sign in with IVAO"
                                Click="OnSignInClick" />
                        <Button x:Name="SignOutButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Content="Sign out" AutomationProperties.Name="Sign out of IVAO"
                                Click="OnSignOutClick" />
                    </StackPanel>
                    <TextBlock Text="{Binding SignInSummary}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SignInStatus}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                    Padding="22,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save settings"
                            AutomationProperties.Name="Save settings"
                            Click="OnSaveClick" MinWidth="118" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Cancel"
                            AutomationProperties.Name="Cancel"
                            Click="OnCancelClick" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                               Text="Changes apply immediately after saving." />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
