<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:TheEye.Desktop.Converters"
             x:Class="TheEye.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://TheEye.Desktop/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://TheEye.Desktop/Styles/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:HexToBrushConverter x:Key="HexToBrush" />
            <converters:IsNotNullConverter x:Key="IsNotNull" />
            <converters:IsNotEmptyConverter x:Key="IsNotEmpty" />
            <converters:InverseBoolConverter x:Key="Not" />
            <converters:BoolToDoubleConverter x:Key="BoolToDouble" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TheEye.Desktop/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
