<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TheEye.Desktop.Controls"
        xmlns:helpers="using:TheEye.Desktop.Helpers"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        x:Class="TheEye.Desktop.MainWindow"
        Title="The Eye of IVAO"
        Icon="/Assets/TheEye.ico"
        Width="1440" Height="900"
        MinWidth="1120" MinHeight="680"
        SystemDecorations="None"
        WindowState="Maximized"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        helpers:FontScaleBehavior.Scale="{Binding FontScale}">

    <!--
        The templates the WPF shell keeps in its resource dictionary, spelled with
        the classes the Avalonia styles define. BoolToVisibility becomes IsVisible
        (Avalonia hides on false) and the three-state status dot is three stacked
        ellipses, because Avalonia has no data triggers.
    -->
    <Window.Resources>
        <DataTemplate x:Key="PilotDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="pill accent" VerticalAlignment="Top">
                        <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" Classes="mono" FontSize="22" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Aircraft}" Classes="muted" />
                            <TextBlock Text="·" Classes="muted" Margin="6,0" />
                            <TextBlock Text="VID" Classes="muted" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding PilotId}" Classes="muted" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is behind the callsign, once IVAO described the session -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,9"
                        IsVisible="{Binding HasProfile}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}" Classes="muted"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="pill" Margin="7,0,0,0" Padding="6,1"
                                        ToolTip.Tip="{Binding RatingName}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,8"
                        IsVisible="{Binding ProfileNotice, Converter={StaticResource IsNotEmpty}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="!" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border Classes="divider" Margin="0,12,0,12" />

                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="FROM" Classes="detail-label" />
                        <TextBlock Text="{Binding Departure}" Classes="mono" FontSize="15"
                                   FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="→" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center" Margin="16,12,16,0" />
                    <StackPanel>
                        <TextBlock Text="TO" Classes="detail-label" />
                        <TextBlock Text="{Binding Arrival}" Classes="mono" FontSize="15"
                                   FontWeight="Bold" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding DepartureName}" Classes="muted"
                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ArrivalName}" Classes="muted" TextTrimming="CharacterEllipsis" />

                <Border Classes="divider" Margin="0,12,0,12" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="ALTITUDE" Classes="detail-label" />
                        <TextBlock Text="{Binding Altitude}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="GROUND SPEED" Classes="detail-label" />
                        <TextBlock Text="{Binding Speed}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="HEADING" Classes="detail-label" />
                        <TextBlock Text="{Binding Heading}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="TRANSPONDER" Classes="detail-label" />
                        <TextBlock Text="{Binding Transponder}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="TIME ONLINE" Classes="detail-label" />
                        <TextBlock Text="{Binding OnlineText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="EST. ARRIVAL" Classes="detail-label" />
                        <TextBlock Text="{Binding EtaText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FLIGHT RULES" Classes="detail-label" />
                        <TextBlock Text="{Binding FlightRules}" Classes="value" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="FLIGHT TYPE" Classes="detail-label" />
                        <TextBlock Text="{Binding FlightType}" Classes="value" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CRUISE LEVEL" Classes="detail-label" />
                        <TextBlock Text="{Binding CruisingLevel}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="1">
                        <TextBlock Text="CRUISE SPEED" Classes="detail-label" />
                        <TextBlock Text="{Binding CruisingSpeed}" Classes="mono value" />
                    </StackPanel>
                </Grid>

                <!-- Connection: the client, simulator and server the member is on -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,9"
                        IsVisible="{Binding HasProfile}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                    ToolTip.Tip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Classes="detail-label" />
                            <TextBlock Text="{Binding SoftwareText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                    ToolTip.Tip="{Binding SimulatorText}">
                            <TextBlock Text="SIMULATOR" Classes="detail-label" />
                            <TextBlock Text="{Binding SimulatorText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"
                                    ToolTip.Tip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Classes="detail-label" />
                            <TextBlock Text="{Binding ServerText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip.Tip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Classes="detail-label" />
                            <TextBlock Text="{Binding ConnectedText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Classes="divider" Margin="0,12,0,12" />

                <TextBlock Text="ROUTE" Classes="detail-label" />
                <TextBlock Text="{Binding RouteText}" Classes="mono value" Margin="0,3,0,0"
                           TextWrapping="Wrap" />

                <!-- <Grid Margin="0,12,0,0" ColumnDefinitions="*,*">
                    <StackPanel>
                        <TextBlock Text="POSITION" Classes="detail-label" />
                        <TextBlock Text="{Binding PositionText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LAST SEEN" Classes="detail-label" />
                        <TextBlock Text="{Binding LastSeenText}" Classes="mono value" />
                    </StackPanel>
                </Grid> -->

                <!-- The filed plan: only there once the detail feed described it -->
                <Border Classes="divider" Margin="0,3,0,12"
                        IsVisible="{Binding HasFlightPlanDetails}" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      IsVisible="{Binding HasFlightPlanDetails}">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="EET" Classes="detail-label" />
                        <TextBlock Text="{Binding EstimatedEnroute}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="ENDURANCE" Classes="detail-label" />
                        <TextBlock Text="{Binding Endurance}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="ALTERNATE" Classes="detail-label" />
                        <TextBlock Text="{Binding Alternate}" Classes="mono value" />
                    </StackPanel>
                    <!-- The second alternate is only worth a row when the plan
                         filed one, which is what the Windows shell does too. -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                                IsVisible="{Binding HasSecondAlternate}">
                        <TextBlock Text="SECOND ALTERNATE" Classes="detail-label" />
                        <TextBlock Text="{Binding Alternate2}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FILED OFF-BLOCKS" Classes="detail-label" />
                        <TextBlock Text="{Binding FiledDepartureText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="ACTUAL OFF-BLOCKS" Classes="detail-label" />
                        <TextBlock Text="{Binding ActualDepartureText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="PEOPLE ON BOARD" Classes="detail-label" />
                        <TextBlock Text="{Binding PeopleOnBoardText}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" ToolTip.Tip="{Binding TransponderTypeText}">
                        <TextBlock Text="TRANSPONDER CAPABILITY" Classes="detail-label" />
                        <TextBlock Text="{Binding TransponderTypeText}" Classes="mono value"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,0,0,9" IsVisible="{Binding HasFlightPlanDetails}"
                            ToolTip.Tip="{Binding EquipmentText}">
                    <TextBlock Text="EQUIPMENT" Classes="detail-label" />
                    <TextBlock Text="{Binding EquipmentText}" Classes="mono value" TextWrapping="Wrap" />
                </StackPanel>

                <Border Classes="flat-card" Margin="0,3,0,0" Padding="11,8"
                        IsVisible="{Binding FlightPlanNotice, Converter={StaticResource IsNotEmpty}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="!" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding FlightPlanNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <StackPanel Margin="0,12,0,0"
                            IsVisible="{Binding Remarks, Converter={StaticResource IsNotEmpty}}">
                    <TextBlock Text="REMARKS" Classes="detail-label" />
                    <TextBlock Text="{Binding Remarks}" Classes="muted" Margin="0,3,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>


        <DataTemplate x:Key="AtcDetailTemplate">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" VerticalAlignment="Top"
                            Background="{Binding AccentSoftColor, Converter={StaticResource HexToBrush}}"
                            BorderBrush="{Binding AccentColor, Converter={StaticResource HexToBrush}}"
                            BorderThickness="1" CornerRadius="8" Padding="7,3">
                        <TextBlock Text="{Binding Facility}" FontSize="9" FontWeight="Bold"
                                   Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding Callsign}" Classes="mono" FontSize="22" FontWeight="Bold" />
                        <Grid Margin="0,2,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding StationName}" Classes="muted"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <TextBlock Text="VID" Classes="muted" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding ControllerId}" Classes="muted" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DockPanel>

                <!-- Identity: who is on the frequency, once IVAO described the session -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,9"
                        IsVisible="{Binding HasProfile}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="{Binding RatingBadge}" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ProfileName}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <Grid Margin="0,3,0,0" ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Source="{Binding FlagImage}" Height="11"
                                       Margin="0,0,6,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <TextBlock Grid.Column="1" Text="{Binding HomeText}" Classes="muted"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Classes="pill" Margin="7,0,0,0" Padding="6,1"
                                        ToolTip.Tip="{Binding RatingName}">
                                    <TextBlock Text="{Binding RatingText}" FontSize="9" FontWeight="Bold" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Why the identity block is missing: the roster feed needs a sign-in or a key -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,8"
                        IsVisible="{Binding ProfileNotice, Converter={StaticResource IsNotEmpty}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Column="0" Text="!" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}" Margin="0,1,7,0"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="{Binding ProfileNotice}" FontSize="10.5"
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Grid>
                </Border>


                <Border Classes="divider" Margin="0,12,0,12" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="FREQUENCY" Classes="detail-label" />
                        <TextBlock Text="{Binding Frequency}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SCOPE" Classes="detail-label" />
                        <TextBlock Text="{Binding Scope}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,10">
                        <TextBlock Text="AIRPORT" Classes="detail-label" />
                        <TextBlock Text="{Binding AirportIcao}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="SECTOR POINTS" Classes="detail-label" />
                        <TextBlock Text="{Binding SectorPoints}" Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"
                                IsVisible="{Binding HasAirport}">
                        <TextBlock Text="CITY" Classes="detail-label" />
                        <TextBlock Text="{Binding City}" Classes="value"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" IsVisible="{Binding HasAirport}">
                        <TextBlock Text="COUNTRY" Classes="detail-label" />
                        <TextBlock Text="{Binding CountryName}" Classes="value"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Connection: the client and server the controller is on -->
                <Border Classes="flat-card" Margin="0,12,0,0" Padding="11,9"
                        IsVisible="{Binding HasProfile}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"
                                    ToolTip.Tip="{Binding SoftwareText}">
                            <TextBlock Text="SOFTWARE" Classes="detail-label" />
                            <TextBlock Text="{Binding SoftwareText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                    ToolTip.Tip="{Binding ServerText}">
                            <TextBlock Text="SERVER" Classes="detail-label" />
                            <TextBlock Text="{Binding ServerText}" Classes="value" Margin="0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TIME ONLINE" Classes="detail-label" />
                            <TextBlock Text="{Binding OnlineText}" Classes="value" Margin="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" ToolTip.Tip="{Binding ConnectedText}">
                            <TextBlock Text="CONNECTED" Classes="detail-label" />
                            <TextBlock Text="{Binding ConnectedText}" Classes="value" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="AirportDetailTemplate">
            <StackPanel>
                <TextBlock Text="{Binding Icao}" Classes="mono" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding DisplayName}" Classes="muted" Margin="0,2,0,0"
                           TextWrapping="Wrap" />
                <Border Classes="divider" Margin="0,12,0,12" />

                <TextBlock Text="METAR" Classes="detail-label" />
                <TextBlock Text="{Binding $parent[Window].DataContext.AirportMetarStatus}"
                           Classes="muted" FontSize="9" Margin="0,2,0,0" />
                <TextBlock Text="{Binding $parent[Window].DataContext.AirportMetarText}"
                           Classes="mono value" Margin="0,5,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding $parent[Window].DataContext.AirportLocationText}"
                           Classes="muted" Margin="0,7,0,0" TextWrapping="Wrap"
                           IsVisible="{Binding $parent[Window].DataContext.HasAirportLocation}" />

                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="POSITION" Classes="detail-label" />
                        <TextBlock Text="{Binding Position.Latitude, StringFormat='{}{0:0.0000}'}"
                                   Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LONGITUDE" Classes="detail-label" />
                        <TextBlock Text="{Binding Position.Longitude, StringFormat='{}{0:0.0000}'}"
                                   Classes="mono value" />
                    </StackPanel>
                </Grid>

                <Border Classes="divider" Margin="0,12,0,12"
                        IsVisible="{Binding HasRunways}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasRunways}">
                    <TextBlock Text="RUNWAYS" Classes="detail-label" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Classes="runway-selector" Width="142" Height="20"
                              Background="{DynamicResource PanelAltBackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              ItemsSource="{Binding $parent[Window].DataContext.SelectedAirportRunwayEnds}"
                              SelectedItem="{Binding $parent[Window].DataContext.SelectedRunwayEnd}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}" Classes="mono value" Margin="0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Border Classes="flat-card" Height="230" Padding="0" Margin="0,7,0,0" ClipToBounds="True"
                        IsVisible="{Binding HasRunways}">
                    <controls:RunwayDiagram State="{Binding $parent[Window].DataContext.RunwayDiagram}"
                                            TextBrush="{DynamicResource TextBrush}"
                                            MutedTextBrush="{DynamicResource MutedTextBrush}"
                                            AccentBrush="{DynamicResource AccentBrush}"
                                            HeadwindBrush="{DynamicResource SuccessBrush}"
                                            TailwindBrush="{DynamicResource ErrorBrush}"
                                            HaloBrush="{DynamicResource PanelAltBackgroundBrush}" />
                </Border>
                <Grid ColumnDefinitions="*,*,*" Margin="0,8,0,0" IsVisible="{Binding HasRunways}">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TRUE HEADING" Classes="detail-label" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.SelectedRunwayEnd.HeadingText}"
                                   Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LENGTH" Classes="detail-label" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.SelectedRunwayEnd.LengthText}"
                                   Classes="mono value" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WIDTH" Classes="detail-label" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.SelectedRunwayEnd.WidthText}"
                                   Classes="mono value" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding $parent[Window].DataContext.RunwayWindDirectionText}"
                           Classes="muted" Margin="0,10,0,0" IsVisible="{Binding HasRunways}" />
                <Grid ColumnDefinitions="*,*" Margin="0,5,0,0" IsVisible="{Binding HasRunways}">
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="CROSSWIND" Classes="detail-label" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.RunwayCrosswindText}"
                                   Classes="mono value" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.RunwayCrosswindSideText}"
                                   Classes="muted" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding $parent[Window].DataContext.RunwayAlongWindLabel}"
                                   Classes="detail-label"
                                   Classes.tailwind="{Binding $parent[Window].DataContext.IsRunwayTailwind}" />
                        <TextBlock Text="{Binding $parent[Window].DataContext.RunwayAlongWindText}"
                                   Classes="mono value" FontSize="16" FontWeight="Bold"
                                   Classes.tailwind="{Binding $parent[Window].DataContext.IsRunwayTailwind}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="No runway data available" Classes="muted" Margin="0,6,0,0"
                           IsVisible="{Binding HasRunways, Converter={StaticResource Not}}" />

                <Border Classes="divider" Margin="0,12,0,12"
                        IsVisible="{Binding $parent[Window].DataContext.HasSelectedAirportAtc}" />
                <TextBlock Text="ACTIVE ATC" Classes="detail-label"
                           IsVisible="{Binding $parent[Window].DataContext.HasSelectedAirportAtc}" />
                <ItemsControl ItemsSource="{Binding $parent[Window].DataContext.SelectedAirportAtc}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Callsign}" Classes="mono value" />
                                    <TextBlock Text="{Binding FacilityName}" Classes="muted" Margin="0,1,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Frequency}" Classes="mono value"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <!-- The row of a member IVAO lists with supervisor rights carries the pink
             wash of the ring the map draws around the badge, so the whole row says
             who watches the network instead of a glyph beside the callsign. The
             wash is the colour the row binds; a row nobody watches binds a
             fully transparent one. -->
        <Style Selector="ListBox.traffic ListBoxItem">
            <Setter Property="Background"
                    Value="{Binding RowTint, Converter={StaticResource HexToBrush}}" />
        </Style>
    </Window.Styles>


    <!-- The window frame: the same 46 / * / 28 rows the Windows chrome draws. -->
    <Panel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Grid RowDefinitions="46,*,28">

                <!-- Caption: brand, live status and the window buttons -->
                <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        PointerPressed="OnTitleBarPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Width="27" Height="27" CornerRadius="7"
                                    Background="{DynamicResource SelectionBrush}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{DynamicResource AccentBrush}"
                                      Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z M 9,5 A 3,3 0 1 1 9,11 A 3,3 0 1 1 9,5 Z" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="THE EYE OF IVAO" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="LIVE NETWORK OVERVIEW" FontSize="8" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Success stays visible underneath; warnings and errors
                                 stack on top, so the dot always shows the worst state. -->
                            <Panel Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse Fill="{DynamicResource SuccessBrush}" />
                                <Ellipse Fill="{DynamicResource WarningBrush}"
                                         IsVisible="{Binding HasWarnings}" />
                                <Ellipse Fill="{DynamicResource ErrorBrush}"
                                         IsVisible="{Binding HasError}" />
                            </Panel>
                            <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Width="1" Height="12" Margin="12,0"
                                    Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{Binding LastUpdatedText}" Classes="muted"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Theme="{StaticResource WindowButton}" ToolTip.Tip="Settings"
                                    AutomationProperties.Name="Settings" Click="OnSettingsClick">
                                <TextBlock Text="⚙" FontSize="12" VerticalAlignment="Center" />
                            </Button>
                            <Button Theme="{StaticResource WindowButton}" ToolTip.Tip="Minimize"
                                    AutomationProperties.Name="Minimize" Click="OnMinimizeClick">
                                <Path Data="M 0,0 L 10,0" StrokeThickness="1" Width="10" Height="2"
                                      Stretch="None"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="MaximizeButton" Theme="{StaticResource WindowButton}"
                                    ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize"
                                    Click="OnMaximizeClick">
                                <Path x:Name="MaximizeGlyph" Stretch="None" StrokeThickness="1"
                                      Width="10" Height="10"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" />
                            </Button>
                            <Button Theme="{StaticResource CloseWindowButton}" ToolTip.Tip="Close"
                                    AutomationProperties.Name="Close" Click="OnCloseClick">
                                <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" StrokeThickness="1"
                                      Width="9" Height="9" Stretch="None"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>


                <Grid Grid.Row="1" x:Name="MainGrid">
                    <!-- Network dashboard, map and selection pane. The dashboard is
                         resizable: the splitter writes its width into the
                         settings, so the column comes back at the width the user
                         left it. The selection pane floats over the right edge of
                         the map instead of taking a column of its own, so the map
                         keeps its width and its position when a selection appears
                         or is cleared. The column limits mirror
                         TheEyeSettings.Min/MaxTrafficColumnWidth. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="322" MinWidth="248" MaxWidth="560" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Network dashboard -->
                    <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Margin="14,14,14,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Pilot table; click again for map"
                                                AutomationProperties.Name="Pilot table" Command="{Binding PilotTableCommand}">
                                            <TextBlock Text="✈" FontSize="13" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="ATC table; click again for map"
                                                AutomationProperties.Name="ATC table" Command="{Binding AtcTableCommand}">
                                            <Grid Width="18" Height="18">
                                                <Ellipse Width="16" Height="16" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <Path Data="M 9,9 L 15,3" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" />
                                                <Ellipse Width="4" Height="4" Fill="{Binding $parent[Button].Foreground}" />
                                            </Grid>
                                        </Button>
                                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Supervisor table"
                                                AutomationProperties.Name="Supervisor table" Command="{Binding SupervisorTableCommand}">
                                            <Path Data="M 8,0 C 8.75,4.5 11.5,7.25 16,8 C 11.5,8.75 8.75,11.5 8,16 C 7.25,11.5 4.5,8.75 0,8 C 4.5,7.25 7.25,4.5 8,0 Z"
                                                  Width="16" Height="16" Fill="{DynamicResource SupervisorBrush}" />
                                        </Button>
                                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Friends table"
                                                AutomationProperties.Name="Friends table" Command="{Binding FriendTableCommand}">
                                            <Grid Width="18" Height="18">
                                                <Ellipse Width="6" Height="6" VerticalAlignment="Top"
                                                         Margin="0,1,0,0"
                                                         Fill="{Binding $parent[Button].Foreground}" />
                                                <Path Data="M 2,17 C 2,12.5 4.5,10 9,10 C 13.5,10 16,12.5 16,17"
                                                      Stroke="{Binding $parent[Button].Foreground}"
                                                      StrokeThickness="1.8" StrokeLineCap="Round" />
                                            </Grid>
                                        </Button>
                                        <Button Theme="{StaticResource IconButton}" ToolTip.Tip="Refresh now"
                                                AutomationProperties.Name="Refresh now" Command="{Binding RefreshCommand}">
                                            <TextBlock Text="↻" FontSize="14" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="NETWORK OVERVIEW" Classes="section" />
                                        <TextBlock Text="{Binding LastUpdatedText}" Classes="muted"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,11,0,0" ColumnDefinitions="*,*,*" IsVisible="False">
                                    <Border Grid.Column="0" Classes="tile">
                                        <StackPanel>
                                            <TextBlock Text="{Binding PilotCount}" Classes="metric-value" />
                                            <TextBlock Text="PILOTS" Classes="metric-label" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Classes="tile">
                                        <StackPanel>
                                            <TextBlock Text="{Binding AtcCount}" Classes="metric-value" />
                                            <TextBlock Text="CONTROLLERS" Classes="metric-label" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Classes="tile" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding TotalCount}" Classes="metric-value" />
                                            <TextBlock Text="CONNECTIONS" Classes="metric-label" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,7,0,0" ColumnDefinitions="*,*,*" IsVisible="False">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding ObserverCount}" Classes="mono"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text=" obs" Classes="muted" Margin="2,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SupervisorCount}" Classes="mono"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text=" sup" Classes="muted" Margin="2,0,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding UniqueUsers24h}" Classes="mono"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text=" /24h" Classes="muted" Margin="2,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         Watermark="Filter by callsign, route, airport…"
                                         Margin="0,12,0,0"
                                         ToolTip.Tip="Filter by callsign, route, airport, facility or country"
                                         AutomationProperties.Name="Filter traffic" IsVisible="False" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14,0,14,14">
                                    <Border Classes="flat-card" Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding TotalCount}" Classes="metric-value" />
                                                <TextBlock Text="ONLINE" Classes="metric-label" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding PilotCount}" Classes="metric-value" />
                                                <TextBlock Text="PILOTS" Classes="metric-label" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding AtcCount}" Classes="metric-value" />
                                                <TextBlock Text="CONTROLLERS" Classes="metric-label" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Classes="flat-card" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="unique users / 24h"
                                                           Classes="muted" FontSize="9" />
                                                <TextBlock Text="ACTIVITY" Classes="detail-label" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding UniqueUsers24h}" Classes="metric-value"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Text="LAST 24 POLLS" Classes="detail-label" Margin="0,0,0,3" />
                                            <ItemsControl ItemsSource="{Binding ActivitySamples}" Height="38" Margin="0,0,0,8">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="6" Height="{Binding BarHeight}" Margin="1,0"
                                                                VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                                                                CornerRadius="2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid ColumnDefinitions="*,*,*">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding WorldTourCount}" Classes="mono" />
                                                    <TextBlock Text=" WT" Classes="muted" Margin="3,0,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding ObserverCount}" Classes="mono" />
                                                    <TextBlock Text=" OBS" Classes="muted" Margin="3,0,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding SupervisorCount}" Classes="mono" />
                                                    <TextBlock Text=" SUP" Classes="muted" Margin="3,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="flat-card" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock DockPanel.Dock="Right" Text="IN / OUT"
                                                           Classes="muted" FontSize="9" />
                                                <TextBlock Text="POPULAR AIRPORTS" Classes="detail-label" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding PopularAirportStats}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="48,*,42" Margin="0,3">
                                                            <TextBlock Text="{Binding Icao}" Classes="mono"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <ProgressBar Height="4" Maximum="100"
                                                                             Value="{Binding InboundPercent}"
                                                                             Foreground="{DynamicResource AccentBrush}"
                                                                             Background="{DynamicResource BorderBrush}" />
                                                                <ProgressBar Height="4" Margin="0,2,0,0" Maximum="100"
                                                                             Value="{Binding OutboundPercent}"
                                                                             Foreground="{DynamicResource MutedTextBrush}"
                                                                             Background="{DynamicResource BorderBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding TrafficText}"
                                                                       Classes="muted" FontSize="9"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No filed airport data in the live feed" Classes="muted"
                                                       IsVisible="{Binding HasNoPopularAirportStats}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Classes="flat-card">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,7">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OnlineFriendCount}"
                                                           Classes="mono" />
                                                <TextBlock Text="FRIENDS ONLINE" Classes="detail-label" />
                                            </DockPanel>
                                            <ItemsControl ItemsSource="{Binding OnlineFriends}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                            <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       Classes="muted"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="No friends online" Classes="muted"
                                                       IsVisible="{Binding HasNoOnlineFriends}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <TabControl Grid.Row="1" SelectedIndex="0" IsVisible="False">
                                <TabItem AutomationProperties.Name="Pilots">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="PILOTS" />
                                            <TextBlock Text="{Binding PilotCount}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="96,*,76,18" Margin="14,8,14,6">
                                            <TextBlock Grid.Column="0" Text="CALLSIGN"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="1" Text="ROUTE" Classes="detail-label" />
                                            <TextBlock Grid.Column="2" Text="ALT" Classes="detail-label"
                                                       HorizontalAlignment="Right" Margin="0" />
                                        </Grid>
                                        <ListBox Grid.Row="1" Classes="traffic"
                                                 ItemsSource="{Binding PilotsView}"
                                                 SelectedItem="{Binding SelectedPilot, Mode=TwoWay}"
                                                 AutomationProperties.Name="Pilot list"
                                                 DoubleTapped="OnTrafficDoubleTapped">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="96,*,76,18" Margin="14,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}"
                                                                   Classes="mono" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RouteLabel}"
                                                                   Classes="muted"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Altitude}"
                                                                   Classes="mono"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="★"
                                                                   Foreground="{DynamicResource SupervisorBrush}"
                                                                   IsVisible="{Binding IsSupervisor}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   ToolTip.Tip="This member holds supervisor rights" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem AutomationProperties.Name="ATC">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ATC" />
                                            <TextBlock Text="{Binding AtcCount}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="96,*,76,18" Margin="14,8,14,6">
                                            <TextBlock Grid.Column="0" Text="CALLSIGN"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="1" Text="FACILITY"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="2" Text="FREQ" Classes="detail-label"
                                                       HorizontalAlignment="Right" Margin="0" />
                                        </Grid>
                                        <ListBox Grid.Row="1" Classes="traffic"
                                                 ItemsSource="{Binding AtcView}"
                                                 SelectedItem="{Binding SelectedAtc, Mode=TwoWay}"
                                                 AutomationProperties.Name="ATC list"
                                                 DoubleTapped="OnTrafficDoubleTapped">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="96,*,76,18" Margin="14,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}"
                                                                   Classes="mono" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding FacilityName}"
                                                                   Classes="muted"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Frequency}"
                                                                   Classes="mono"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                        <TextBlock Grid.Column="3" Text="★"
                                                                   Foreground="{DynamicResource SupervisorBrush}"
                                                                   IsVisible="{Binding IsSupervisor}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   ToolTip.Tip="This member holds supervisor rights" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem AutomationProperties.Name="Supervisors">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SUP" />
                                            <TextBlock Text="{Binding SupervisorListCount}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource SupervisorBrush}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="96,*" Margin="14,8,14,6">
                                            <TextBlock Grid.Column="0" Text="CALLSIGN"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="1" Text="MEMBER"
                                                       Classes="detail-label" />
                                        </Grid>
                                        <ListBox Grid.Row="1" Classes="traffic"
                                                 ItemsSource="{Binding SupervisorsView}"
                                                 SelectedItem="{Binding SelectedSupervisor, Mode=TwoWay}"
                                                 AutomationProperties.Name="Supervisor list"
                                                 DoubleTapped="OnTrafficDoubleTapped">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="96,*" Margin="14,0"
                                                          ToolTip.Tip="{Binding TooltipText}">
                                                        <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}"
                                                                   Classes="mono" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Classes="muted"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                                <TabItem AutomationProperties.Name="Friends">
                                    <TabItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="FRIENDS" />
                                            <TextBlock Text="{Binding FriendCount}" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </TabItem.Header>
                                    <Grid RowDefinitions="Auto,*">
                                        <Grid ColumnDefinitions="96,*,70,20" Margin="14,8,14,6">
                                            <TextBlock Grid.Column="0" Text="CALLSIGN"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="1" Text="MEMBER"
                                                       Classes="detail-label" />
                                            <TextBlock Grid.Column="2" Text="STATE"
                                                       Classes="detail-label" />
                                        </Grid>
                                        <ListBox Grid.Row="1" Classes="traffic"
                                                 ItemsSource="{Binding FriendsView}"
                                                 SelectedItem="{Binding SelectedFriend, Mode=TwoWay}"
                                                 AutomationProperties.Name="Friend list"
                                                 DoubleTapped="OnTrafficDoubleTapped">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="96,*,70,20" Margin="14,0"
                                                          ToolTip.Tip="{Binding TooltipText}">
                                                        <TextBlock Grid.Column="0" Text="{Binding Callsign}"
                                                                   Classes="mono" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                   Classes="muted"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ActivityText}"
                                                                   Classes="mono" FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Button Grid.Column="3" Theme="{StaticResource IconButton}"
                                                                Width="20" Height="20"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource MutedTextBrush}"
                                                                ToolTip.Tip="Remove this friend"
                                                                AutomationProperties.Name="Remove friend"
                                                                Command="{Binding $parent[Window].DataContext.ToggleFriendCommand}"
                                                                CommandParameter="{Binding}">
                                                            <!-- Drawn instead of typed: a font glyph can land as
                                                                 an empty box in the button. -->
                                                            <Path Data="M 0.6,2.6 H 9.4 M 3.4,2.6 V 1.1 H 6.6 V 2.6 M 1.5,2.6 L 2.1,9.4 H 7.9 L 8.5,2.6"
                                                                  StrokeThickness="1.1" Width="10" Height="10"
                                                                  Stretch="None"
                                                                  Stroke="{Binding $parent[Button].Foreground}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>



                    <!-- The grab handle of the network dashboard. A transparent
                         four pixel strip keeps the panel borders as the only
                         visible separator. -->
                    <GridSplitter x:Name="TrafficSplitter" Grid.Column="1" Width="4" Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                  AutomationProperties.Name="Resize dashboard"
                                  ToolTip.Tip="Drag to resize the dashboard" />

                    <!-- Offline world map with the aircraft pins layered on top -->
                      <Grid x:Name="MapHost" Grid.Column="2" Background="{DynamicResource MapWaterBrush}" ClipToBounds="True"
                          IsVisible="{Binding IsMapView}">
                        <mapsui:MapControl x:Name="MapView" Map="{Binding Map.Map}"
                                           MapTapped="OnMapTapped"
                                           PointerMoved="OnMapPointerMoved"
                                           PointerExited="OnMapPointerExited" />

                        <!-- Every pin is placed in screen pixels by the view model, so
                             panning and zooming moves it without this overlay knowing
                             anything about the map. -->
                        <ItemsControl ItemsSource="{Binding Map.Pilots}"
                                      IsVisible="{Binding ShowPilots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AircraftCanvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                    <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="{Binding MarkerSize}" RowDefinitions="Auto,Auto">
                                        <Button Theme="{StaticResource PilotMarkerButton}"
                                            PointerEntered="OnPilotMarkerEnter"
                                            PointerExited="OnPilotMarkerLeave"
                                            Click="OnPilotMarkerClick" />
                                        <TextBlock Grid.Row="1" Text="{Binding Callsign}" Margin="-100,0,-100,0"
                                               TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="None"
                                               FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                               IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Canvas IsHitTestVisible="False">
                            <Border Canvas.Left="{Binding Map.MapTooltipX}" Canvas.Top="{Binding Map.MapTooltipY}"
                                    IsVisible="{Binding Map.HasMapTooltip}" Width="190"
                                    Padding="10,6" CornerRadius="4"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <TextBlock Text="{Binding Map.MapTooltipText}" FontSize="12"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}" />
                            </Border>
                        </Canvas>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Top" Margin="14">
                            <ToggleButton Content="PILOTS" IsChecked="{Binding ShowPilots, Mode=TwoWay}"
                                          Margin="0,0,6,0" ToolTip.Tip="Show or hide aircraft" />
                            <ToggleButton Content="ATC" IsChecked="{Binding ShowAtc, Mode=TwoWay}"
                                          Margin="0,0,6,0" ToolTip.Tip="Show or hide controllers, sectors and stations" />
                            <ToggleButton Content="AIRPORTS" IsChecked="{Binding ShowAirports, Mode=TwoWay}"
                                          ToolTip.Tip="Show or hide airports with active traffic" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14">
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,7" Margin="0,0,0,6"
                                    IsVisible="{Binding HasError}">
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                           TextWrapping="Wrap" MaxWidth="520" />
                            </Border>
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,7"
                                    IsVisible="{Binding HasVisibleWarnings}">
                                <TextBlock Text="{Binding WarningText}"
                                           Foreground="{DynamicResource WarningBrush}" FontSize="11"
                                           TextWrapping="Wrap" MaxWidth="520" />
                            </Border>
                            <Border Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,7" Margin="0,6,0,0"
                                    IsVisible="{Binding HasTrackNotice}">
                                <TextBlock Text="{Binding TrackNotice}"
                                           Foreground="{DynamicResource WarningBrush}" FontSize="11"
                                           TextWrapping="Wrap" MaxWidth="520" />
                            </Border>
                        </StackPanel>


                        <!-- The selection pane covers the right edge of the map
                             while something is selected, so the zoom controls step
                             left by its width instead of hiding under it. -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14">
                            <Border Width="348" IsVisible="{Binding HasSelection}" />
                            <StackPanel>
                                <Button Theme="{StaticResource SquareButton}" ToolTip.Tip="Zoom in"
                                        AutomationProperties.Name="Zoom in"
                                        Command="{Binding ZoomInCommand}" Margin="0,0,0,5">
                                    <TextBlock Text="+" FontSize="14" VerticalAlignment="Center" />
                                </Button>
                                <Button Theme="{StaticResource SquareButton}" ToolTip.Tip="Zoom out"
                                        AutomationProperties.Name="Zoom out"
                                        Command="{Binding ZoomOutCommand}" Margin="0,0,0,5">
                                    <TextBlock Text="−" FontSize="14" VerticalAlignment="Center" />
                                </Button>
                                <Button Theme="{StaticResource SquareButton}"
                                        ToolTip.Tip="Reset the world view"
                                        AutomationProperties.Name="Reset view"
                                        Command="{Binding HomeCommand}">
                                    <TextBlock Text="⌂" FontSize="13" VerticalAlignment="Center" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Border Classes="map-overlay" HorizontalAlignment="Left"
                                VerticalAlignment="Bottom" Margin="14">
                            <TextBlock Classes="muted" FontSize="9.5"
                                       Text="DRAG TO PAN  ·  SCROLL TO ZOOM  ·  CLICK TO SELECT" />
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" ZIndex="3" IsVisible="{Binding IsPilotTableView}"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="190"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Filter pilots…"
                                             ToolTip.Tip="Filter by callsign, route, airport, facility or country"
                                             AutomationProperties.Name="Search pilots" Margin="12,0,14,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding PilotTableSortStatus}"
                                               Classes="muted" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock Text="ONLINE PILOTS" Classes="section" Margin="14,12" />
                                </DockPanel>
                            </Border>
                                <ScrollViewer Grid.Row="1" Margin="0,0,0,42" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Background="{DynamicResource HeaderBackgroundBrush}"
                                        ColumnDefinitions="1.1*,1.5*,1.1*,0.72*,0.72*,0.78*,0.78*,0.92*,0.9*">
                                        <Button Grid.Column="0" Theme="{StaticResource GhostButton}" Content="CALLSIGN" Command="{Binding SortPilotTableCommand}" CommandParameter="Callsign" />
                                        <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Content="MEMBER" Command="{Binding SortPilotTableCommand}" CommandParameter="Member" />
                                        <Button Grid.Column="2" Theme="{StaticResource GhostButton}" Content="AIRCRAFT" Command="{Binding SortPilotTableCommand}" CommandParameter="Aircraft" />
                                        <Button Grid.Column="3" Theme="{StaticResource GhostButton}" Content="FROM" Command="{Binding SortPilotTableCommand}" CommandParameter="Departure" />
                                        <Button Grid.Column="4" Theme="{StaticResource GhostButton}" Content="TO" Command="{Binding SortPilotTableCommand}" CommandParameter="Arrival" />
                                        <Button Grid.Column="5" Theme="{StaticResource GhostButton}" Content="ALT" Command="{Binding SortPilotTableCommand}" CommandParameter="Altitude" />
                                        <Button Grid.Column="6" Theme="{StaticResource GhostButton}" Content="SPEED" Command="{Binding SortPilotTableCommand}" CommandParameter="Speed" />
                                        <Button Grid.Column="7" Theme="{StaticResource GhostButton}" Content="STATE" Command="{Binding SortPilotTableCommand}" CommandParameter="State" />
                                        <Button Grid.Column="8" Theme="{StaticResource GhostButton}" Content="ONLINE" Command="{Binding SortPilotTableCommand}" CommandParameter="Online" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PilotsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Theme="{StaticResource GhostButton}" Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].DataContext.SelectPilotFromTableCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                    <Grid ColumnDefinitions="1.1*,1.5*,1.1*,0.72*,0.72*,0.78*,0.78*,0.92*,0.9*">
                                                        <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CallsignLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MemberText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MemberText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Aircraft}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Aircraft}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Departure}" Classes="mono" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Arrival}" Classes="mono" />
                                                        <TextBlock Grid.Column="5" Text="{Binding Altitude}" Classes="mono" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Speed}" Classes="mono" />
                                                        <TextBlock Grid.Column="7" Text="{Binding State}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="8" Text="{Binding OnlineText}" Classes="mono" />
                                                    </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="14,0,0,10" Padding="8,5"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FRIENDS" FontSize="9" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" Margin="5,0,10,0"
                                            Background="#38BDF8" />
                                    <TextBlock Text="SUPERVISORS" FontSize="9" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" Margin="5,0,0,0"
                                            Background="#E84393" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" ZIndex="3" IsVisible="{Binding IsAtcTableView}"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="190"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Filter controllers…"
                                             ToolTip.Tip="Filter by callsign, route, airport, facility or country"
                                             AutomationProperties.Name="Search controllers" Margin="12,0,14,0" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding AtcTableSortStatus}"
                                               Classes="muted" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <TextBlock Text="ONLINE ATC" Classes="section" Margin="14,12" />
                                </DockPanel>
                            </Border>
                                <ScrollViewer Grid.Row="1" Margin="0,0,0,42" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Background="{DynamicResource HeaderBackgroundBrush}"
                                        ColumnDefinitions="1.1*,1.5*,0.9*,0.9*,1.05*,1.45*,2.5*,0.9*">
                                        <Button Grid.Column="0" Theme="{StaticResource GhostButton}" Content="CALLSIGN" Command="{Binding SortAtcTableCommand}" CommandParameter="Callsign" />
                                        <Button Grid.Column="1" Theme="{StaticResource GhostButton}" Content="MEMBER" Command="{Binding SortAtcTableCommand}" CommandParameter="Member" />
                                        <Button Grid.Column="2" Theme="{StaticResource GhostButton}" Content="FACILITY" Command="{Binding SortAtcTableCommand}" CommandParameter="Facility" />
                                        <Button Grid.Column="3" Theme="{StaticResource GhostButton}" Content="FREQ" Command="{Binding SortAtcTableCommand}" CommandParameter="Frequency" />
                                        <Button Grid.Column="4" Theme="{StaticResource GhostButton}" Content="AIRPORT" Command="{Binding SortAtcTableCommand}" CommandParameter="Airport" />
                                        <Button Grid.Column="5" Theme="{StaticResource GhostButton}" Content="COUNTRY" Command="{Binding SortAtcTableCommand}" CommandParameter="Country" />
                                        <Button Grid.Column="6" Theme="{StaticResource GhostButton}" Content="SCOPE" Command="{Binding SortAtcTableCommand}" CommandParameter="Scope" />
                                        <Button Grid.Column="7" Theme="{StaticResource GhostButton}" Content="ONLINE" Command="{Binding SortAtcTableCommand}" CommandParameter="Online" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding AtcView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Theme="{StaticResource GhostButton}" Padding="0"
                                                    HorizontalContentAlignment="Stretch"
                                                    Command="{Binding $parent[Window].DataContext.SelectAtcFromTableCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                    <Grid ColumnDefinitions="1.1*,1.5*,0.9*,0.9*,1.05*,1.45*,2.5*,0.9*">
                                                        <TextBlock Grid.Column="0" Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CallsignLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding MemberText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding MemberText}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding FacilityName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FacilityName}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Frequency}" Classes="mono" />
                                                        <TextBlock Grid.Column="4" Text="{Binding AirportIcao}" Classes="mono" />
                                                        <TextBlock Grid.Column="5" Text="{Binding CountryName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CountryName}" />
                                                        <TextBlock Grid.Column="6" Text="{Binding Scope}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Scope}" />
                                                        <TextBlock Grid.Column="7" Text="{Binding OnlineText}" Classes="mono" />
                                                    </Grid>
                                                </Border>
                                                    </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <Border Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                    Margin="14,0,0,10" Padding="8,5"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FRIENDS" FontSize="9" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" Margin="5,0,10,0"
                                            Background="#38BDF8" />
                                    <TextBlock Text="SUPERVISORS" FontSize="9" VerticalAlignment="Center" />
                                    <Border Width="8" Height="8" Margin="5,0,0,0"
                                            Background="#E84393" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" ZIndex="3" IsVisible="{Binding IsSupervisorTableView}"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="190"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Filter supervisors…"
                                             AutomationProperties.Name="Search supervisors" Margin="12,0,14,0" />
                                    <TextBlock Text="SUPERVISORS" Classes="section" Margin="14,12" />
                                </DockPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid ColumnDefinitions="1.1*,1.5*,1.1*,1.2*,2*,0.9*"
                                          Background="{DynamicResource HeaderBackgroundBrush}">
                                        <TextBlock Grid.Column="0" Text="CALLSIGN" Classes="detail-label" />
                                        <TextBlock Grid.Column="1" Text="MEMBER" Classes="detail-label" />
                                        <TextBlock Grid.Column="2" Text="CONNECTED AS" Classes="detail-label" />
                                        <TextBlock Grid.Column="3" Text="DIVISION" Classes="detail-label" />
                                        <TextBlock Grid.Column="4" Text="STAFF POSITIONS" Classes="detail-label" />
                                        <TextBlock Grid.Column="5" Text="ONLINE" Classes="detail-label" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding SupervisorsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Theme="{StaticResource GhostButton}" Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].DataContext.SelectSupervisorFromTableCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                        <Grid ColumnDefinitions="1.1*,1.5*,1.1*,1.2*,2*,0.9*">
                                                            <TextBlock Text="{Binding CallsignLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ConnectionText}" />
                                                            <TextBlock Grid.Column="3" Text="{Binding DivisionText}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="4" Text="{Binding StaffText}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="5" Text="{Binding OnlineText}" Classes="mono" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" ZIndex="3" IsVisible="{Binding IsFriendTableView}"
                            Background="{DynamicResource PanelBackgroundBrush}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <TextBox DockPanel.Dock="Right" Width="190"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Filter friends…"
                                             AutomationProperties.Name="Search friends" Margin="12,0,14,0" />
                                    <TextBlock Text="FRIENDS" Classes="section" Margin="14,12" />
                                </DockPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid ColumnDefinitions="1.1*,1.5*,1.1*,2*,0.9*"
                                          Background="{DynamicResource HeaderBackgroundBrush}">
                                        <TextBlock Grid.Column="0" Text="CALLSIGN" Classes="detail-label" />
                                        <TextBlock Grid.Column="1" Text="MEMBER" Classes="detail-label" />
                                        <TextBlock Grid.Column="2" Text="ACTIVITY" Classes="detail-label" />
                                        <TextBlock Grid.Column="3" Text="DETAILS" Classes="detail-label" />
                                        <TextBlock Grid.Column="4" Text="ONLINE" Classes="detail-label" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FriendsView}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Theme="{StaticResource GhostButton}" Padding="0"
                                                        HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].DataContext.SelectFriendFromTableCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="{Binding RowTint, Converter={StaticResource HexToBrush}}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                                                        <Grid ColumnDefinitions="1.1*,1.5*,1.1*,2*,0.9*">
                                                            <TextBlock Text="{Binding Callsign}" FontWeight="SemiBold" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding ActivityText}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="3" Text="{Binding DetailText}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="4" Text="{Binding OnlineText}" Classes="mono" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>



                    <!-- Selection detail pane. It floats over the right edge of the
                         map while something is selected, so opening and closing it
                         never resizes or moves the map underneath; with nothing
                         picked there is nothing to inspect and it is hidden. -->
                    <Border Grid.Column="2" Width="348" ZIndex="4"
                            HorizontalAlignment="Right"
                            IsVisible="{Binding HasSelection}"
                            Background="{DynamicResource PanelBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="14,11">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Theme="{StaticResource IconButton}"
                                            ToolTip.Tip="Clear selection"
                                            AutomationProperties.Name="Clear selection"
                                            Command="{Binding ClearSelectionCommand}"
                                            VerticalAlignment="Center">
                                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" StrokeThickness="1"
                                              Width="9" Height="9" Stretch="None"
                                              Stroke="{Binding $parent[Button].Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                    <Button DockPanel.Dock="Right" Theme="{StaticResource GhostButton}"
                                            Height="20" Padding="8,1" FontSize="9" Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Content="{Binding FriendActionText}"
                                            Command="{Binding ToggleFriendCommand}"
                                            IsVisible="{Binding HasMemberSelection}"
                                            AutomationProperties.Name="Toggle friend"
                                            ToolTip.Tip="Follow this member: their callsign carries a star in the lists and they are collected on the FRIENDS tab" />
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="SELECTION" Classes="section" />
                                            <Border Classes="pill accent" Margin="8,0,0,0" Padding="6,1"
                                                    Background="{DynamicResource SupervisorBrush}"
                                                    IsVisible="{Binding IsSelectionSupervisor}">
                                                <TextBlock Text="SUPERVISOR" FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Click a marker, sector or list row"
                                                   Classes="muted" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- The gutter belongs to the content, not to the
                                 ScrollViewer: Avalonia measures the scrolled
                                 child at the unpadded width, so wrapping fields
                                 such as ROUTE laid themselves out 16px wider
                                 than the pane and their last word ran under the
                                 panel border. -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="16,14,16,18">
                                    <ContentControl Content="{Binding SelectedPilot}"
                                                    ContentTemplate="{StaticResource PilotDetailTemplate}"
                                                    IsVisible="{Binding SelectedPilot, Converter={StaticResource IsNotNull}}" />
                                    <ContentControl Content="{Binding SelectedAtc}"
                                                    ContentTemplate="{StaticResource AtcDetailTemplate}"
                                                    IsVisible="{Binding SelectedAtc, Converter={StaticResource IsNotNull}}" />
                                    <ContentControl Content="{Binding SelectedAirport}"
                                                    ContentTemplate="{StaticResource AirportDetailTemplate}"
                                                    IsVisible="{Binding SelectedAirport, Converter={StaticResource IsNotNull}}" />
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status bar: live connection facts and the two settings entries -->
                <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="14,0" VerticalAlignment="Center">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding RefreshDescription}" Classes="muted"
                                       VerticalAlignment="Center" />
                            <Border Width="1" Height="11" Margin="10,0"
                                    Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{Binding ThemeDescription}" Classes="muted"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Theme="{StaticResource GhostButton}" Content="SETTINGS"
                                    Height="20" Padding="8,0" FontSize="9"
                                    Click="OnSettingsClick" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                                     Margin="0,0,7,0" />
                            <TextBlock Text="{Binding StatusText}" Classes="mono" FontSize="10"
                                       VerticalAlignment="Center" />
                            <Border Width="1" Height="11" Margin="10,0"
                                    Background="{DynamicResource BorderBrush}" />
                            <TextBlock Text="{Binding ConnectionDescription}" Classes="muted"
                                       VerticalAlignment="Center" />
                            <Border Width="1" Height="11" Margin="10,0"
                                    Background="{DynamicResource BorderBrush}" />
                            <TextBlock Classes="muted" VerticalAlignment="Center"
                                       Text="{Binding Map.Pilots.Count, StringFormat='{}{0} aircraft tracked'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Panel>
</Window>
