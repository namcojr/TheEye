<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TheEye.Desktop</RootNamespace>
    <AssemblyName>TheEye.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheEye.Core\TheEye.Core.csproj" />
    <ProjectReference Include="..\TheEye.Presentation\TheEye.Presentation.csproj" />
    <Compile Include="..\Shared\AircraftLayerRenderer.cs" Link="Rendering\AircraftLayerRenderer.cs" />
    <Compile Include="..\Shared\AtcGlyphRenderer.cs" Link="Rendering\AtcGlyphRenderer.cs" />
    <Compile Include="..\Shared\CachedPolygonRenderer.cs" Link="Rendering\CachedPolygonRenderer.cs" />
    <Compile Include="..\Shared\MapRenderers.cs" Link="Rendering\MapRenderers.cs" />
    <Compile Include="..\Shared\RunwayDiagramRenderer.cs" Link="Rendering\RunwayDiagramRenderer.cs" />
    <Compile Include="..\Shared\WrappedMapRenderer.cs" Link="Rendering\WrappedMapRenderer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Mapsui.Avalonia" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The artwork lives in the repository root so the executable, the window
         and the Linux launcher wear the same icon. It is embedded rather than
         copied so "avares://TheEye.Desktop/Assets/TheEye.ico" resolves on every
         platform, whatever the working directory is. -->
    <AvaloniaResource Include="../../TheEye.ico" Link="Assets/TheEye.ico" />
  </ItemGroup>

</Project>
