<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The text and surface vocabulary the Windows dictionaries define with
        keys becomes classes here: Avalonia styles are the natural place for
        "this TextBlock is a section title", and every colour stays dynamic so a
        palette switch reaches text nobody has re-created.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontFamily"
                Value="avares://Avalonia.Fonts.Inter/Assets#Inter,Segoe UI,Cantarell,DejaVu Sans" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.card-title">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily"
                Value="Consolas,JetBrains Mono,DejaVu Sans Mono,Noto Sans Mono,monospace" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.metric-value">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBlock.metric-label">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.detail-label">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,8,2" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,9" />
    </Style>

    <!-- A tailwind on the selected runway end is the one wind value that must stand out. -->
    <Style Selector="TextBlock.tailwind">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style Selector="Border.flat-card">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="11" />
    </Style>

    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pill.accent">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Border.map-overlay">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="9,6" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily"
                Value="Consolas,JetBrains Mono,DejaVu Sans Mono,Noto Sans Mono,monospace" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- Fluent gives every ComboBox MinHeight 32 and 5/7 px of vertical padding;
         both have to go for a compact selector, or MinHeight beats Height. -->
    <Style Selector="ComboBox.runway-selector">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="8,0,0,0" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="ListBox.traffic">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
